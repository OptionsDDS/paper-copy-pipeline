+import pyaes  # element_boxer_sc patch: AES-CBC from vendored pure-Python pyaes in place of cryptography
+
+
+def _sc_aes_cbc(key: bytes, iv: bytes, data: bytes, decrypt: bool) -> bytes:
+    """element_boxer_sc patch: AES-CBC over the whole 16-byte blocks of data, no padding added or removed
+    (what cryptography's update() returned here)."""
+    mode = pyaes.AESModeOfOperationCBC(bytes(key), iv=bytes(iv))
+    out = bytearray()
+    for i in range(0, len(data) - len(data) % 16, 16):
+        out += mode.decrypt(bytes(data[i:i + 16])) if decrypt else mode.encrypt(bytes(data[i:i + 16]))
+    return bytes(out)
 
